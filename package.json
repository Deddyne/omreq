{
  "name": "omreq-workspace",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm generate && pnpm build:js && pnpm build:native",
    "generate": "node scripts/generate-profile-types.mjs",
    "build:js": "node scripts/clean-dist.mjs && tsc -p packages/omreq/tsconfig.json && node scripts/build-esm.mjs",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc -p packages/omreq/tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:bun": "bun run scripts/test-bun.mjs",
    "check": "pnpm lint && pnpm typecheck && cargo fmt --all --check && cargo clippy --workspace --locked --all-targets -- -D warnings && cargo test --workspace --locked && pnpm test && pnpm test:bun",
    "pack:check": "node scripts/pack-check.mjs",
    "evidence": "node scripts/evidence.mjs",
    "docs:llms": "node scripts/build-llms.mjs",
    "lint": "biome check packages/omreq/src scripts tests fixtures",
    "format": "biome check --write packages/omreq/src scripts tests fixtures",
    "verify:transport": "node scripts/verify-transport.mjs",
    "test:transport": "cargo test --manifest-path vendor/http2/Cargo.toml --lib --locked && node scripts/test-quic.mjs",
    "test:transport:wreq": "node scripts/test-wreq.mjs",
    "test:profile:reference": "node scripts/qualify-profile.mjs",
    "profile:new": "node scripts/profile-new.mjs",
    "profile:qualify": "node scripts/qualify-profile.mjs",
    "test:profile:resumption": "node scripts/profile-resumption-reference.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@napi-rs/cli": "3.10.12",
    "@types/node": "26.0.1",
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2"
  }
}

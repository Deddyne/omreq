{
  "name": "omreq",
  "version": "0.1.0",
  "description": "The fastest HTTP client for Node.js and Bun with a real Chrome TLS fingerprint (JA3/JA4) and HTTP/2 fingerprint. Rust + BoringSSL, browser impersonation, proxies, cookies, streaming.",
  "keywords": ["http-client", "tls-fingerprint", "browser-fingerprint", "ja3", "ja4", "akamai", "impersonation", "browser-emulation", "chrome", "cloudflare", "cloudflare-bypass", "anti-bot", "anti-detection", "bot-detection", "tls", "http2", "fetch", "web-scraping", "scraping", "crawler", "proxy", "socks5", "typescript", "nodejs", "bun", "rust", "wreq", "boringssl"],
  "license": "MIT",
  "homepage": "https://github.com/Deddyne/omreq#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Deddyne/omreq.git", "directory": "packages/omreq" },
  "bugs": "https://github.com/Deddyne/omreq/issues",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "os": ["darwin", "linux", "win32"],
  "cpu": ["arm64", "x64"],
  "engines": { "node": ">=22" },
  "dependencies": { "jsonc-parser": "3.3.1" },
  "optionalDependencies": {
    "@omreq/darwin-arm64": "workspace:0.1.0",
    "@omreq/linux-x64-gnu": "workspace:0.1.0",
    "@omreq/win32-x64-msvc": "workspace:0.1.0"
  }
}

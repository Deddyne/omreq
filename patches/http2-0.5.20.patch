+
+    #[test]
+    fn header_list_bound_applies_without_and_caps_advertised_settings() {
+        let mut framed = read();
+        framed.set_max_frame_size(frame::DEFAULT_MAX_FRAME_SIZE as usize);
+        assert_eq!(framed.max_header_list_size, LOCAL_MAX_HEADER_LIST_SIZE);
+        framed.set_max_header_list_size(16 << 20);
+        assert_eq!(framed.max_header_list_size, LOCAL_MAX_HEADER_LIST_SIZE);
+        framed.set_max_header_list_size(16 << 10);
+        assert_eq!(framed.max_header_list_size, 16 << 10);
+        // At the default 16 KiB frame size, CONTINUATION buffering stays near
+        // the bound instead of 1280 frames (20 MiB).
+        framed.set_max_header_list_size(usize::MAX);
+        assert_eq!(framed.max_continuation_frames, 20);
+    }
 }

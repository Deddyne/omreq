+    #[test]
+    fn smaller_policy_uses_plain_bytes_on_ties_and_expansion() {
+        for input in [b"?0".as_slice(), b"\"macOS\"", b"\xff"] {
+            let mut bytes=BytesMut::new();encode_str(input,&mut bytes,true);
+            assert_eq!(bytes[0]&0x80,0);assert_eq!(&bytes[1..],input);
+        }
+    }
+    #[test]
+    fn smaller_policy_still_compresses_when_shorter_and_preserves_legacy_default() {
+        let mut bytes=BytesMut::new();encode_str(b"www.example.com",&mut bytes,true);assert_eq!(bytes[0]&0x80,0x80);
+        let mut legacy=BytesMut::new();encode_str(b"?0",&mut legacy,false);assert_eq!(legacy[0]&0x80,0x80);
+    }

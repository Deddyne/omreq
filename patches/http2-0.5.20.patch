+    use tokio_util::codec::length_delimited;
+
+    fn read() -> FramedRead<&'static [u8]> {
+        FramedRead::new(
+            length_delimited::Builder::new()
+                .big_endian()
+                .length_field_length(3)
+                .length_adjustment(9)
+                .num_skip(0)
+                .new_read(&[][..]),
+        )
